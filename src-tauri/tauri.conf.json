{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoB Redux",
  "version": "0.1.0",
  "identifier": "dev.pobredux.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PoB Redux",
        "width": 1520,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": false,
    "shortDescription": "Path of Building for Path of Exile 2, rebuilt.",
    "longDescription": "A fast, modern desktop build planner for Path of Exile 2 that runs Path of Building Community's real calculation engine.",
    "resources": {
      "resources/pob/": "pob/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
