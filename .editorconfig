root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

# PoB's Lua uses tabs; keep the shim files consistent with what they patch.
[*.lua]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
